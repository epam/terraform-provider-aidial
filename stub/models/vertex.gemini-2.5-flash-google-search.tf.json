              "region": "global"
            }
          },
          {
            "extraData": {
              "project": "example-project-1",
              "region": "global"
            }
          }
        ],
        "user_roles": [
          "full",
          "statgpt-service",
          "user"
        ],
        "default_headers": {},
        "interceptors": []
      }
    }
