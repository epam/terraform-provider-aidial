        "name": "vertex.gemini-2.5-flash-google-search",
        "type": "CHAT",
        "display_name": "Google Gemini 2.5 Flash",
        "display_version": "Latest, With Google Search Grounding",
        "override_name": "gemini-2.5-flash-google-search",
        "icon_url": "Gemini-Pro-Vision.svg",
        "description": "Gemini 2.5 Flash with Google Search grounding is Google's fast, general-purpose multimodal model augmented with real-time search results.",
        "input_attachment_types": [
          "*/*"
        ],
        "description_keywords": [
          "Text Generation",
          "Image Recognition",
          "PDF Supported",
          "TXT Supported",
          "Video Recognition",
          "Google Search Grounding",
          "Functions",
          "GCP"
        ],
        "features": {
          "tools_supported": true
        },
        "defaults": {
