{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug test (current file's package)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Debug test (selected name)",
      "type": "go",
